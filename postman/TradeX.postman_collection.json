{
  "info": {
    "name": "TradeX API",
    "description": "Postman collection for TradeX MERN paper trading platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"user@test.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@tradex.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Stocks",
      "item": [
        {
          "name": "Search Stocks",
          "request": { "method": "GET", "url": "{{baseUrl}}/stocks/search?q=AAPL" }
        },
        {
          "name": "Popular Stocks",
          "request": { "method": "GET", "url": "{{baseUrl}}/stocks/popular" }
        },
        {
          "name": "Get Quote",
          "request": { "method": "GET", "url": "{{baseUrl}}/stocks/quote/AAPL" }
        },
        {
          "name": "Get History",
          "request": { "method": "GET", "url": "{{baseUrl}}/stocks/history/AAPL?range=1M" }
        },
        {
          "name": "Admin List Stocks",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/stocks"
          }
        },
        {
          "name": "Admin Create Stock",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symbol\": \"NFLX\",\n  \"name\": \"Netflix Inc.\",\n  \"exchange\": \"NASDAQ\",\n  \"sector\": \"Entertainment\",\n  \"isActive\": true\n}"
            },
            "url": "{{baseUrl}}/stocks"
          }
        }
      ]
    },
    {
      "name": "Trade",
      "item": [
        {
          "name": "Buy Stock",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symbol\": \"AAPL\",\n  \"quantity\": 5\n}"
            },
            "url": "{{baseUrl}}/trade/buy"
          }
        },
        {
          "name": "Sell Stock",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symbol\": \"AAPL\",\n  \"quantity\": 2\n}"
            },
            "url": "{{baseUrl}}/trade/sell"
          }
        }
      ]
    },
    {
      "name": "Portfolio",
      "item": [
        {
          "name": "Get Portfolio",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/portfolio"
          }
        },
        {
          "name": "Get Transactions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/portfolio/transactions"
          }
        },
        {
          "name": "Get Performance",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/portfolio/performance"
          }
        }
      ]
    },
    {
      "name": "Watchlist",
      "item": [
        {
          "name": "Get Watchlist",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/watchlist"
          }
        },
        {
          "name": "Add to Watchlist",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"symbol\": \"AAPL\"\n}" },
            "url": "{{baseUrl}}/watchlist"
          }
        },
        {
          "name": "Remove from Watchlist",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/watchlist/AAPL"
          }
        }
      ]
    }
  ]
}
